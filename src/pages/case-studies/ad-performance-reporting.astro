---
import Layout from '@/layouts/Layout.astro';

const caseStudy = {
  title: 'Automated Ad Performance Reporting for Multi-Channel Media Sales',
  company: 'Digital Media Publisher',
  industry: 'Publishing & Media',
  industryIcon: '📰',
  solutionType: 'Multi-Platform Data Integration',
  metric: '16 hrs',
  metricLabel: 'Saved Per Week',
  timeline: '6 months',
};

const relatedCases = [
  {
    slug: 'email-campaign-link-management',
    title: 'Email Campaign Link Management',
    industryIcon: '📰',
    metric: '$1-5K',
    metricLabel: 'Monthly Savings',
  },
  {
    slug: 'manufacturing-production-scheduling',
    title: 'Manufacturing Production Scheduling',
    industryIcon: '🏭',
    metric: '87.5%',
    metricLabel: 'Time Reduction',
  },
  {
    slug: 'content-strategy-growth',
    title: 'Data-Driven Content Strategy',
    industryIcon: '💻',
    metric: '900%',
    metricLabel: 'Growth',
  },
];
---

<Layout
  title="Automated Ad Performance Reporting | Case Studies | Automation Architech"
  description="Saved 16 hours per week automating multi-platform ad performance reporting. Eliminated manual CSV downloads and prevented $1-5K monthly ad refunds."
>
  <!-- Hero Section -->
  <section class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb & Discovery Call Button -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
        <!-- Left: Breadcrumb -->
        <a href="/case-studies" class="text-gray-500 hover:text-gray-900 transition-colors">
          ← Back to Case Studies
        </a>

        <!-- Right: Discovery Call CTA -->
        <a href="/#contact"
           class="rounded-lg bg-gray-900 px-6 py-3 font-medium text-white
                  transition-colors duration-200 hover:bg-gray-800 whitespace-nowrap">
          Book 15-Minute Discovery Call
        </a>
      </div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-4 mb-6">
        <!-- Industry Tag -->
        <a
          href="/#industries"
          class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 rounded-lg text-sm font-semibold text-gray-700 hover:bg-gray-200 transition-colors"
        >
          <span class="text-xl">{caseStudy.industryIcon}</span>
          {caseStudy.industry}
        </a>

        <!-- Solution Type Tag -->
        <a
          href="/#services"
          class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 rounded-lg text-sm font-semibold text-gray-700 hover:bg-gray-200 transition-colors"
        >
          {caseStudy.solutionType}
        </a>
      </div>

      <!-- Title -->
      <h1 class="text-5xl font-light text-gray-900 mb-6">
        {caseStudy.title}
      </h1>

      <!-- Primary Metric -->
      <div class="bg-gray-50 rounded-xl p-8 mb-8">
        <div class="text-6xl font-light text-gray-900 mb-2">
          {caseStudy.metric}
        </div>
        <div class="text-xl font-medium text-gray-600">
          {caseStudy.metricLabel}
        </div>
      </div>

      <!-- Quick Facts Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div>
          <div class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">
            Industry
          </div>
          <div class="text-lg text-gray-900">
            {caseStudy.industry}
          </div>
        </div>

        <div>
          <div class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">
            Company
          </div>
          <div class="text-lg text-gray-900">
            {caseStudy.company}
          </div>
        </div>

        <div>
          <div class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">
            Timeline
          </div>
          <div class="text-lg text-gray-900">
            {caseStudy.timeline}
          </div>
        </div>

        <div>
          <div class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">
            Solution Type
          </div>
          <div class="text-lg text-gray-900">
            {caseStudy.solutionType}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">

        <!-- Problem Section -->
        <h2 class="text-4xl font-light text-gray-900 mb-6 mt-0">
          Problem
        </h2>
        <p class="text-gray-600 leading-relaxed mb-6">
          A digital media publisher with 500+ advertising customers was struggling with manual ad performance reporting across multiple platforms. Their 9-person sales and operations team, distributed across multiple regions, was running 2-4 campaigns per day and spending significant time on data collection and reporting.
        </p>

        <h3 class="text-2xl font-semibold text-gray-900 mb-4 mt-8">
          Critical Pain Points
        </h3>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-8">
          <li>Manual CSV downloads from multiple advertising platforms (Google Ads, Facebook Ads, programmatic networks)</li>
          <li>Time-consuming data compilation and normalization across different reporting formats</li>
          <li>16 hours per week spent on data collection and report generation</li>
          <li>Frequent reporting delays affecting client communication</li>
          <li>Inconsistent metrics across platforms requiring manual reconciliation</li>
          <li>Limited ability to identify underperforming campaigns in real-time</li>
          <li>$1-5K monthly ad refunds due to performance issues caught too late</li>
        </ul>

        <!-- Solution Section -->
        <h2 class="text-4xl font-light text-gray-900 mb-6 mt-12">
          Solution
        </h2>

        <h3 class="text-2xl font-semibold text-gray-900 mb-4 mt-8">
          Automated Multi-Platform Reporting System
        </h3>
        <p class="text-gray-600 leading-relaxed mb-6">
          We designed and implemented a comprehensive automated reporting system that integrated with all major advertising platforms, normalized data across sources, and delivered real-time performance insights.
        </p>

        <h4 class="text-xl font-semibold text-gray-900 mb-3 mt-6">
          Implementation Timeline
        </h4>
        <p class="text-gray-600 leading-relaxed mb-6">
          The project was completed over 6 months with phased rollout:
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li><strong class="font-semibold text-gray-900">Month 1-2:</strong> Requirements gathering, API integration planning, and proof of concept</li>
          <li><strong class="font-semibold text-gray-900">Month 3-4:</strong> Core integration development and data pipeline construction</li>
          <li><strong class="font-semibold text-gray-900">Month 5:</strong> Dashboard development and user acceptance testing</li>
          <li><strong class="font-semibold text-gray-900">Month 6:</strong> Production deployment and team training</li>
        </ul>

        <h4 class="text-xl font-semibold text-gray-900 mb-3 mt-6">
          Core System Architecture
        </h4>

        <p class="text-gray-600 leading-relaxed mb-4">
          <strong class="font-semibold text-gray-900">1. Multi-Platform Data Integration</strong>
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>API connections to Google Ads, Facebook Ads, and programmatic ad networks</li>
          <li>Automated daily data pulls with retry logic for failed requests</li>
          <li>Incremental data updates to minimize API quota usage</li>
        </ul>

        <p class="text-gray-600 leading-relaxed mb-4">
          <strong class="font-semibold text-gray-900">2. Data Normalization Pipeline</strong>
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>Unified data schema across all advertising platforms</li>
          <li>Automatic currency conversion for international campaigns</li>
          <li>Metric standardization (impressions, clicks, conversions, CPM, CTR, etc.)</li>
          <li>Data quality validation and anomaly detection</li>
        </ul>

        <p class="text-gray-600 leading-relaxed mb-4">
          <strong class="font-semibold text-gray-900">3. Centralized Data Warehouse</strong>
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>Cloud-based data warehouse for historical performance tracking</li>
          <li>Optimized query performance for real-time dashboard updates</li>
          <li>Automated backup and disaster recovery</li>
        </ul>

        <p class="text-gray-600 leading-relaxed mb-4">
          <strong class="font-semibold text-gray-900">4. Automated Reporting Dashboard</strong>
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>Real-time campaign performance visualization</li>
          <li>Custom views for sales team, operations team, and leadership</li>
          <li>Automated alert system for underperforming campaigns</li>
          <li>One-click client report generation</li>
          <li>Mobile-responsive design for on-the-go access</li>
        </ul>

        <p class="text-gray-600 leading-relaxed mb-4">
          <strong class="font-semibold text-gray-900">5. Alert and Notification System</strong>
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>Proactive alerts for campaigns falling below performance thresholds</li>
          <li>Daily summary emails with key metrics</li>
          <li>Slack integration for real-time team notifications</li>
        </ul>

        <h4 class="text-xl font-semibold text-gray-900 mb-3 mt-6">
          New Analytical Capabilities
        </h4>
        <p class="text-gray-600 leading-relaxed mb-6">
          Beyond automating existing reporting, the system enabled new strategic capabilities:
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>Cross-platform performance comparison and optimization opportunities</li>
          <li>Historical trend analysis for better campaign planning</li>
          <li>Customer lifetime value tracking across multiple campaigns</li>
          <li>Predictive analytics for campaign performance forecasting</li>
        </ul>

        <h3 class="text-2xl font-semibold text-gray-900 mb-4 mt-8">
          Users
        </h3>
        <p class="text-gray-600 leading-relaxed mb-6">
          The system serves multiple stakeholder groups:
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-8">
          <li><strong class="font-semibold text-gray-900">Sales Team:</strong> Access to real-time client performance for proactive communication</li>
          <li><strong class="font-semibold text-gray-900">Operations Team:</strong> Campaign monitoring and optimization insights</li>
          <li><strong class="font-semibold text-gray-900">Leadership:</strong> High-level performance dashboards and revenue tracking</li>
          <li><strong class="font-semibold text-gray-900">Clients:</strong> Self-service access to their campaign performance data</li>
        </ul>

        <!-- Impact Section -->
        <h2 class="text-4xl font-light text-gray-900 mb-6 mt-12">
          Impact
        </h2>

        <h3 class="text-2xl font-semibold text-gray-900 mb-4 mt-8">
          Time Savings
        </h3>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>Eliminated 16 hours per week of manual data collection and compilation</li>
          <li>Reduced client report generation from 30 minutes to 2 minutes per report</li>
          <li>Freed up operations team to focus on campaign optimization instead of data wrangling</li>
        </ul>

        <h3 class="text-2xl font-semibold text-gray-900 mb-4 mt-8">
          Quality Improvements
        </h3>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>Eliminated manual data entry errors</li>
          <li>Consistent metrics across all platforms and reports</li>
          <li>Real-time data availability (no more waiting for weekly reports)</li>
          <li>Audit trail for all data transformations and calculations</li>
        </ul>

        <h3 class="text-2xl font-semibold text-gray-900 mb-4 mt-8">
          Business Outcomes
        </h3>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>$1-5K monthly savings through early detection of underperforming campaigns</li>
          <li>Improved client satisfaction through proactive performance communication</li>
          <li>Increased ad revenue from better campaign optimization</li>
          <li>Faster response time to client inquiries</li>
        </ul>

        <h3 class="text-2xl font-semibold text-gray-900 mb-4 mt-8">
          New Strategic Capabilities
        </h3>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-8">
          <li>Data-driven campaign strategy development</li>
          <li>Platform performance comparison enabling better media mix decisions</li>
          <li>Predictive modeling for campaign forecasting</li>
          <li>Cross-campaign insights revealing customer behavior patterns</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Technical Highlights Section -->
  <section class="bg-white py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <details class="group" open>
        <summary class="cursor-pointer list-none">
          <div class="flex items-center justify-between p-6 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
            <h3 class="text-2xl font-semibold text-gray-900">
              Technical Highlights
            </h3>
            <svg class="w-6 h-6 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </summary>

        <div class="mt-6 prose prose-lg max-w-none">
          <ul class="space-y-2 list-disc pl-6 text-gray-600">
            <li>Multi-platform API integration (Google Ads API, Facebook Marketing API, custom programmatic network APIs)</li>
            <li>ETL pipeline with robust error handling and retry logic</li>
            <li>Cloud data warehouse optimized for fast analytical queries</li>
            <li>Real-time data synchronization with incremental updates</li>
            <li>Custom data normalization layer to handle platform-specific quirks</li>
            <li>Automated currency conversion using live exchange rates</li>
            <li>Role-based access control for different user groups</li>
            <li>Responsive dashboard with interactive data visualization</li>
            <li>Scheduled report generation and distribution</li>
            <li>Slack and email notification integrations</li>
          </ul>
        </div>
      </details>
    </div>
  </section>

  <!-- Key Learnings Section -->
  <section class="bg-white py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <details class="group" open>
        <summary class="cursor-pointer list-none">
          <div class="flex items-center justify-between p-6 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
            <h3 class="text-2xl font-semibold text-gray-900">
              Key Learnings
            </h3>
            <svg class="w-6 h-6 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </summary>

        <div class="mt-6 prose prose-lg max-w-none">
          <div class="mb-6">
            <p class="text-gray-600 leading-relaxed mb-4">
              <strong class="font-semibold text-gray-900">API Rate Limits and Quota Management</strong>
            </p>
            <p class="text-gray-600 leading-relaxed">
              Managing API rate limits across multiple platforms required careful orchestration. We implemented intelligent request batching, caching strategies, and incremental data updates to stay within quota limits while maintaining data freshness.
            </p>
          </div>

          <div class="mb-6">
            <p class="text-gray-600 leading-relaxed mb-4">
              <strong class="font-semibold text-gray-900">Data Quality Challenges</strong>
            </p>
            <p class="text-gray-600 leading-relaxed">
              Different platforms report metrics with varying levels of accuracy and latency. Building data validation rules and anomaly detection helped identify and flag inconsistencies early, preventing downstream reporting issues.
            </p>
          </div>

          <div class="mb-6">
            <p class="text-gray-600 leading-relaxed mb-4">
              <strong class="font-semibold text-gray-900">Phased Rollout Benefits</strong>
            </p>
            <p class="text-gray-600 leading-relaxed">
              Starting with a single advertising platform proof-of-concept allowed us to refine the data model and user interface before scaling to additional platforms. This iterative approach reduced risk and enabled early user feedback.
            </p>
          </div>

          <div class="mb-6">
            <p class="text-gray-600 leading-relaxed mb-4">
              <strong class="font-semibold text-gray-900">User Adoption Strategy</strong>
            </p>
            <p class="text-gray-600 leading-relaxed">
              The distributed team required careful change management. We created role-specific training sessions and maintained the manual reports in parallel for one month to build confidence in the automated system before full transition.
            </p>
          </div>
        </div>
      </details>
    </div>
  </section>

  <!-- Visual Evidence Section -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Placeholder 1 -->
        <div class="aspect-video bg-gray-100 rounded-lg flex items-center justify-center border-2 border-dashed border-gray-300">
          <span class="text-sm text-gray-400">Screenshot Placeholder 1</span>
        </div>

        <!-- Placeholder 2 -->
        <div class="aspect-video bg-gray-100 rounded-lg flex items-center justify-center border-2 border-dashed border-gray-300">
          <span class="text-sm text-gray-400">Screenshot Placeholder 2</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section (After Key Learnings) -->
  <section class="border-t border-gray-200 bg-gray-50 py-16">
    <div class="mx-auto max-w-2xl text-center px-4 sm:px-6 lg:px-8">
      <h2 class="mb-4 text-3xl font-light text-gray-900">
        Ready to See Similar Results?
      </h2>
      <p class="mb-8 text-lg text-gray-600">
        Tell us about your biggest bottleneck—we'll tell you if we can help.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a href="/#contact"
           class="rounded-lg bg-gray-900 px-8 py-4 font-medium text-white
                  transition-colors duration-200 hover:bg-gray-800">
          Book 15-Minute Discovery Call
        </a>
        <a href="/case-studies"
           class="rounded-lg border-2 border-gray-300 bg-white px-8 py-4 font-medium
                  text-gray-900 transition-colors duration-200 hover:bg-gray-50">
          View All Case Studies
        </a>
      </div>
    </div>
  </section>

  <!-- Related Case Studies -->
  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-light text-gray-900 mb-12 text-center">
        Related Case Studies
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {relatedCases.map((study) => (
          <a
            href={`/case-studies/${study.slug}`}
            class="bg-white rounded-xl p-6 border border-gray-200 hover:shadow-lg transition-all duration-300 group"
          >
            <!-- Icon -->
            <span class="text-3xl mb-4 block">{study.industryIcon}</span>

            <!-- Title -->
            <h3 class="text-xl font-semibold text-gray-900 mb-3 group-hover:text-gray-700 transition-colors">
              {study.title}
            </h3>

            <!-- Metric -->
            <div class="text-3xl font-light text-gray-900 mb-1">
              {study.metric}
            </div>
            <div class="text-sm font-medium text-gray-500 mb-4">
              {study.metricLabel}
            </div>

            <!-- CTA -->
            <div class="flex items-center text-gray-900 font-medium group-hover:text-gray-700 transition-colors">
              Read more
              <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
