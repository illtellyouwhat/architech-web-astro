---
import Layout from '@/layouts/Layout.astro';

const caseStudy = {
  title: 'Mixed Analytics: Data-Driven Content Strategy for SaaS Growth',
  company: 'Mixed Analytics',
  industry: 'SaaS',
  industryIcon: '💻',
  solutionType: 'AI Decision Support',
  metric: '900%',
  metricLabel: 'Growth (200K → 2M MAU)',
  timeline: 'Pre-ChatGPT era',
};

const relatedCases = [
  {
    slug: 'clinical-trial-patient-matching',
    title: 'AI-Powered Clinical Trial Patient Matching',
    industryIcon: '❤️',
    metric: '6-7x',
    metricLabel: 'Capacity Increase',
  },
  {
    slug: 'ad-performance-reporting',
    title: 'Automated Ad Performance Reporting',
    industryIcon: '📰',
    metric: '16 hrs',
    metricLabel: 'Saved Per Week',
  },
  {
    slug: 'manufacturing-production-scheduling',
    title: 'Manufacturing Production Scheduling',
    industryIcon: '🏭',
    metric: '87.5%',
    metricLabel: 'Time Reduction',
  },
];
---

<Layout
  title="Data-Driven Content Strategy for SaaS Growth | Case Studies | Automation Architech"
  description="Grew SaaS product from 200K to 2M monthly active users (900% increase) through data-driven content strategy and SEO optimization."
>
  <!-- Hero Section -->
  <section class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb & Discovery Call Button -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
        <!-- Left: Breadcrumb -->
        <a href="/case-studies" class="text-gray-500 hover:text-gray-900 transition-colors">
          ← Back to Case Studies
        </a>

        <!-- Right: Discovery Call CTA -->
        <a href="/#contact"
           class="rounded-lg bg-gray-900 px-6 py-3 font-medium text-white
                  transition-colors duration-200 hover:bg-gray-800 whitespace-nowrap">
          Book 15-Minute Discovery Call
        </a>
      </div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-4 mb-6">
        <!-- Industry Tag -->
        <a
          href="/#industries"
          class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 rounded-lg text-sm font-semibold text-gray-700 hover:bg-gray-200 transition-colors"
        >
          <span class="text-xl">{caseStudy.industryIcon}</span>
          {caseStudy.industry}
        </a>

        <!-- Solution Type Tag -->
        <a
          href="/#services"
          class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 rounded-lg text-sm font-semibold text-gray-700 hover:bg-gray-200 transition-colors"
        >
          {caseStudy.solutionType}
        </a>
      </div>

      <!-- Company Logo Placeholder -->
      <div class="mb-6">
        <div class="w-48 h-24 bg-gray-100 rounded-lg flex items-center justify-center border-2 border-dashed border-gray-300">
          <span class="text-sm text-gray-400 text-center px-4">
            Mixed Analytics<br/>Logo Placeholder
          </span>
        </div>
      </div>

      <!-- Title -->
      <h1 class="text-5xl font-light text-gray-900 mb-6">
        {caseStudy.title}
      </h1>

      <!-- Primary Metric -->
      <div class="bg-gray-50 rounded-xl p-8 mb-8">
        <div class="text-6xl font-light text-gray-900 mb-2">
          {caseStudy.metric}
        </div>
        <div class="text-xl font-medium text-gray-600">
          {caseStudy.metricLabel}
        </div>
      </div>

      <!-- Quick Facts Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div>
          <div class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">
            Industry
          </div>
          <div class="text-lg text-gray-900">
            {caseStudy.industry}
          </div>
        </div>

        <div>
          <div class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">
            Company
          </div>
          <div class="text-lg text-gray-900">
            {caseStudy.company}
          </div>
        </div>

        <div>
          <div class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">
            Timeline
          </div>
          <div class="text-lg text-gray-900">
            {caseStudy.timeline}
          </div>
        </div>

        <div>
          <div class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">
            Solution Type
          </div>
          <div class="text-lg text-gray-900">
            {caseStudy.solutionType}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">

        <!-- Problem Section -->
        <h2 class="text-4xl font-light text-gray-900 mb-6 mt-0">
          Problem
        </h2>
        <p class="text-gray-600 leading-relaxed mb-6">
          Mixed Analytics had developed a Chrome extension that enabled users to pull API data directly into Google Sheets—a powerful tool for the no-code/low-code community. However, despite having a useful product, they struggled to grow their user base beyond 200,000 monthly active users.
        </p>
        <p class="text-gray-600 leading-relaxed mb-8">
          The company needed a data-driven approach to content strategy that would increase product visibility, attract qualified users, and establish thought leadership in the automation and data integration space. In the pre-ChatGPT era, this required manual content research, SEO optimization, and strategic topic selection based on search intent and competition analysis.
        </p>

        <!-- Solution Section -->
        <h2 class="text-4xl font-light text-gray-900 mb-6 mt-12">
          Solution
        </h2>

        <h3 class="text-2xl font-semibold text-gray-900 mb-4 mt-8">
          Data-Driven Content Strategy
        </h3>
        <p class="text-gray-600 leading-relaxed mb-6">
          We developed and executed a comprehensive content strategy rooted in search data, competitive analysis, and user intent research. The approach combined quantitative SEO analysis with qualitative understanding of the target audience's pain points.
        </p>

        <h4 class="text-xl font-semibold text-gray-900 mb-3 mt-6">
          Analytics Approach
        </h4>
        <p class="text-gray-600 leading-relaxed mb-6">
          Our strategy was built on systematic data analysis:
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>Keyword research identifying high-volume, low-competition topics in the API integration and Google Sheets automation space</li>
          <li>Search intent analysis to understand what users were actually trying to accomplish</li>
          <li>Competitor content gap analysis revealing underserved topics</li>
          <li>Performance tracking and iterative optimization based on traffic and engagement metrics</li>
          <li>User behavior analysis to identify content that drove product adoption</li>
        </ul>

        <h4 class="text-xl font-semibold text-gray-900 mb-3 mt-6">
          Two-Pronged Content Strategy
        </h4>
        <p class="text-gray-600 leading-relaxed mb-6">
          We executed content across two primary channels, each optimized for different stages of the user journey:
        </p>

        <p class="text-gray-600 leading-relaxed mb-4">
          <strong class="font-semibold text-gray-900">Blog Posts</strong>
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>In-depth technical tutorials on API integrations and Google Sheets automation</li>
          <li>SEO-optimized for specific tool combinations and use cases</li>
          <li>Step-by-step guides with screenshots and code examples</li>
          <li>Content designed to rank for long-tail keywords with high purchase intent</li>
          <li>Internal linking strategy to drive users from educational content to product pages</li>
        </ul>

        <p class="text-gray-600 leading-relaxed mb-4">
          <strong class="font-semibold text-gray-900">YouTube Videos</strong>
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-6">
          <li>Visual tutorials demonstrating the Chrome extension in action</li>
          <li>Screen recordings showing real-world automation workflows</li>
          <li>Optimized titles and descriptions for YouTube search</li>
          <li>Complementary to blog content, capturing users who prefer video learning</li>
          <li>Built subscriber base for ongoing engagement and retention</li>
        </ul>

        <h3 class="text-2xl font-semibold text-gray-900 mb-4 mt-8">
          Content Scope
        </h3>
        <p class="text-gray-600 leading-relaxed mb-6">
          The content production effort was substantial but strategically focused:
        </p>
        <ul class="space-y-2 list-disc pl-6 text-gray-600 mb-8">
          <li>100+ blog posts covering various API integrations, automation workflows, and use cases</li>
          <li>14 YouTube videos demonstrating key product features and common automation scenarios</li>
          <li>YouTube channel grew from 0 to 2,000+ subscribers</li>
          <li>Content calendar aligned with product releases and seasonal trends</li>
          <li>Regular content updates to maintain SEO rankings and accuracy</li>
        </ul>

        <!-- Impact Section -->
        <h2 class="text-4xl font-light text-gray-900 mb-6 mt-12">
          Impact
        </h2>
        <ul class="space-y-3 list-disc pl-6 text-gray-600 mb-8">
          <li>
            <strong class="font-semibold text-gray-900">900% User Growth:</strong> Monthly active users grew from 200K to 2M+
          </li>
          <li>
            <strong class="font-semibold text-gray-900">Organic Traffic Dominance:</strong> Content marketing became the primary user acquisition channel
          </li>
          <li>
            <strong class="font-semibold text-gray-900">YouTube Community Building:</strong> Built engaged subscriber base of 2,000+ from scratch with just 14 videos
          </li>
          <li>
            <strong class="font-semibold text-gray-900">Improved Conversion Rates:</strong> Educational content pre-qualified users, leading to higher activation rates
          </li>
          <li>
            <strong class="font-semibold text-gray-900">Thought Leadership:</strong> Established Mixed Analytics as authority in API integration and Google Sheets automation
          </li>
          <li>
            <strong class="font-semibold text-gray-900">Sustainable Growth:</strong> Content assets continue to drive user acquisition years after publication
          </li>
          <li>
            <strong class="font-semibold text-gray-900">Reduced Customer Support:</strong> Comprehensive tutorials reduced support ticket volume for common questions
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Technical Highlights Section -->
  <section class="bg-white py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <details class="group" open>
        <summary class="cursor-pointer list-none">
          <div class="flex items-center justify-between p-6 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
            <h3 class="text-2xl font-semibold text-gray-900">
              Technical Highlights
            </h3>
            <svg class="w-6 h-6 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </summary>

        <div class="mt-6 prose prose-lg max-w-none">
          <ul class="space-y-2 list-disc pl-6 text-gray-600">
            <li>Pre-ChatGPT content strategy requiring manual keyword research and topic ideation</li>
            <li>SEO optimization techniques including keyword placement, internal linking, and technical SEO</li>
            <li>Data-driven topic selection based on search volume, competition, and user intent analysis</li>
            <li>YouTube SEO optimization for video discovery and ranking</li>
            <li>Content performance tracking and iterative optimization</li>
            <li>Multi-channel content distribution strategy (blog, YouTube, social media)</li>
            <li>User journey mapping to align content with acquisition and activation goals</li>
            <li>Analytics implementation to measure content ROI and user behavior</li>
          </ul>
        </div>
      </details>
    </div>
  </section>

  <!-- Key Learnings Section -->
  <section class="bg-white py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <details class="group" open>
        <summary class="cursor-pointer list-none">
          <div class="flex items-center justify-between p-6 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
            <h3 class="text-2xl font-semibold text-gray-900">
              Key Learnings
            </h3>
            <svg class="w-6 h-6 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </summary>

        <div class="mt-6 prose prose-lg max-w-none">
          <p class="text-gray-600 leading-relaxed mb-6">
            This pre-ChatGPT content strategy demonstrates that systematic, data-driven approaches to content creation can drive exponential growth. The key was not volume for volume's sake, but strategically targeting topics where the product could provide genuine value to users searching for solutions.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            The two-channel approach (blog + YouTube) captured users at different stages of awareness and with different learning preferences. Some users discovered the product through blog posts while researching specific integrations, while others found YouTube tutorials when looking for visual demonstrations.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Content quality and depth mattered more than quantity. The 100+ blog posts and 14 YouTube videos were all comprehensive, tutorial-style content that genuinely helped users accomplish their goals. This approach built trust and positioned the product as a solution rather than just another tool.
          </p>
          <p class="text-gray-600 leading-relaxed">
            The long-term compounding effect of evergreen content is powerful. Years after publication, these content assets continue to drive new user acquisition without ongoing investment, demonstrating the value of content as a sustainable growth channel for SaaS products.
          </p>
        </div>
      </details>
    </div>
  </section>

  <!-- Visual Evidence Section -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Placeholder 1 -->
        <div class="aspect-video bg-gray-100 rounded-lg flex items-center justify-center border-2 border-dashed border-gray-300">
          <span class="text-sm text-gray-400">Screenshot Placeholder 1</span>
        </div>

        <!-- Placeholder 2 -->
        <div class="aspect-video bg-gray-100 rounded-lg flex items-center justify-center border-2 border-dashed border-gray-300">
          <span class="text-sm text-gray-400">Screenshot Placeholder 2</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section (After Key Learnings) -->
  <section class="border-t border-gray-200 bg-gray-50 py-16">
    <div class="mx-auto max-w-2xl text-center px-4 sm:px-6 lg:px-8">
      <h2 class="mb-4 text-3xl font-light text-gray-900">
        Ready to See Similar Results?
      </h2>
      <p class="mb-8 text-lg text-gray-600">
        Tell us about your biggest bottleneck—we'll tell you if we can help.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a href="/#contact"
           class="rounded-lg bg-gray-900 px-8 py-4 font-medium text-white
                  transition-colors duration-200 hover:bg-gray-800">
          Book 15-Minute Discovery Call
        </a>
        <a href="/case-studies"
           class="rounded-lg border-2 border-gray-300 bg-white px-8 py-4 font-medium
                  text-gray-900 transition-colors duration-200 hover:bg-gray-50">
          View All Case Studies
        </a>
      </div>
    </div>
  </section>

  <!-- Related Case Studies -->
  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-light text-gray-900 mb-12 text-center">
        Related Case Studies
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {relatedCases.map((study) => (
          <a
            href={`/case-studies/${study.slug}`}
            class="bg-white rounded-xl p-6 border border-gray-200 hover:shadow-lg transition-all duration-300 group"
          >
            <!-- Icon -->
            <span class="text-3xl mb-4 block">{study.industryIcon}</span>

            <!-- Title -->
            <h3 class="text-xl font-semibold text-gray-900 mb-3 group-hover:text-gray-700 transition-colors">
              {study.title}
            </h3>

            <!-- Metric -->
            <div class="text-3xl font-light text-gray-900 mb-1">
              {study.metric}
            </div>
            <div class="text-sm font-medium text-gray-500 mb-4">
              {study.metricLabel}
            </div>

            <!-- CTA -->
            <div class="flex items-center text-gray-900 font-medium group-hover:text-gray-700 transition-colors">
              Read more
              <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
