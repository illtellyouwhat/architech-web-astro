---
import RevealOnScroll from '../react/RevealOnScroll';

const differentiators = [
  {
    title: "We Find Solutions When APIs Don't Cooperate",
    copy: "Platform rate limits? Missing endpoints? We build workarounds that respect Terms of Service while getting you the data you need. (Examples: Klaviyo link-level tracking, Coda API caching layer)"
  },
  {
    title: '6-Week Implementations, Not 6-Month Projects',
    copy: 'We combine low-code platforms (Coda, Notion, Zapier) with custom code where needed. You get production systems in weeks, not the multi-month timelines of unnecessary custom development.'
  },
  {
    title: 'AI That Actually Works (99% Accuracy)',
    copy: "We built LLM applications before ChatGPT was mainstream. Dual-LLM verification, RAG vector search, hallucination reduction—we know how to make AI reliable for production use."
  }
];
---
<section id="about" class="bg-gray-50 py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Eyebrow -->
    <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-gray-900">
      About
    </p>

    <!-- Headline -->
    <h2 class="mb-6 text-4xl font-light text-gray-900">
      Why Companies Choose Us
    </h2>

    <!-- Subheadline -->
    <p class="mb-12 text-lg text-gray-600">
      We combine LLM expertise, low-code implementation, and a focus on measurable results. From 6-week implementations to 99% AI accuracy and API workarounds—we solve the problems other agencies can't.
    </p>

    <!-- Two-Column Grid -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">

      <!-- Left Column: Differentiator Cards -->
      <div class="space-y-8">

        {differentiators.map((item) => (
          <div class="rounded-xl border border-gray-100 bg-white p-6">
            <h3 class="text-lg font-medium text-gray-900">{item.title}</h3>
            <RevealOnScroll client:visible>
              <p class="mt-2 text-gray-500">{item.copy}</p>
            </RevealOnScroll>
          </div>
        ))}

      </div>

      <!-- Right Column: Team Photo Placeholder -->
      <div class="flex items-center justify-center">
        <div class="flex w-full max-w-md flex-col items-center justify-center rounded-xl border-2 border-dashed border-gray-200 bg-white" style="aspect-ratio: 3/4;">
          <svg class="mb-4 h-16 w-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span class="text-sm font-medium text-gray-400">Team/Founder Photo</span>
          <span class="mt-1 text-xs text-gray-400">Placeholder</span>
        </div>
      </div>

    </div>
  </div>
</section>
