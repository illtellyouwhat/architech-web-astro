---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config/site';
import ContactForm from '../react/ContactForm';
---
<section id="contact" class="bg-white py-20">
  <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-gray-500">Contact</p>
    <h2 class="mt-4 text-4xl font-light text-gray-900">Ready to Automate?</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
      Tell us about your biggest bottleneck—we'll tell you if we can help.
    </p>

    {/* Contact Form */}
    <div class="mt-12 mb-16">
      <ContactForm client:visible />
    </div>

    {/* Contact Info Cards */}
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <article class="rounded-2xl border border-gray-100 p-6 text-left shadow-sm">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-gray-100">
            <Icon name="lucide:mail" class="h-5 w-5 text-gray-500" />
          </span>
          <div>
            <p class="text-sm uppercase tracking-wide text-gray-500">Email</p>
            <a class="text-lg font-medium text-gray-900" href={`mailto:${siteConfig.email}`}>
              {siteConfig.email}
            </a>
          </div>
        </div>
        <p class="mt-4 text-sm text-gray-500">
          Expect a thoughtful reply with next steps inside 24 hours.
        </p>
      </article>

      <article class="flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:shadow-lg">
        {/* Icon */}
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
          <Icon name="lucide:video" class="h-8 w-8 text-gray-900" />
        </div>

        {/* Label */}
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">
          Schedule via Google Meet
        </p>

        {/* CTA Button */}
        <a href="https://calendar.app.google/EVcS3xj7ud1BWtkL6"
           class="mb-3 rounded-lg bg-gray-900 px-6 py-3 font-medium text-white
                  transition-colors duration-200 hover:bg-gray-800">
          Schedule via Google Meet
        </a>

        {/* Subtext */}
        <p class="text-sm text-gray-500">
          Book a video call at a time that works for you.
        </p>
      </article>

      <article class="flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:shadow-lg">
        {/* Icon */}
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
          <Icon name="lucide:phone" class="h-8 w-8 text-gray-900" />
        </div>

        {/* Label */}
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">
          Schedule a Phone Call
        </p>

        {/* CTA Button */}
        <a href="https://calendar.app.google/mnKPd1jZJn9fyKTu9"
           class="mb-3 rounded-lg bg-gray-900 px-6 py-3 font-medium text-white
                  transition-colors duration-200 hover:bg-gray-800">
          Schedule a Phone Call
        </a>

        {/* Subtext */}
        <p class="text-sm text-gray-500">
          Prefer to talk by phone? Schedule a call that fits your schedule.
        </p>
      </article>
    </div>
  </div>
</section>
