---
import { Icon } from 'astro-icon/components';

const stats = [
  { icon: 'lucide:briefcase', number: '50+', label: 'Projects Delivered' },
  { icon: 'lucide:calendar', number: '8 Years', label: 'Industry Experience' },
  { icon: 'lucide:clock', number: '87.5%', label: 'Average Time Reduction' },
  { icon: 'lucide:check-circle', number: '99%', label: 'AI Accuracy' }
];
---
<!-- Stats Section -->
<section class="border-b border-t border-gray-100 bg-white py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Stats Grid - 4 cards in horizontal row -->
    <div class="grid grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">

      {stats.map((stat) => (
        <a href="/case-studies" class="block text-center transition-all duration-300 hover:scale-105">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-gray-50">
            <Icon name={stat.icon} class="h-6 w-6 text-gray-900" />
          </div>
          <div class="mb-2 text-3xl font-light text-gray-900 md:text-4xl">{stat.number}</div>
          <div class="text-sm font-medium text-gray-900">{stat.label}</div>
        </a>
      ))}

    </div>
  </div>
</section>
